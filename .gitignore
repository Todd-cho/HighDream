/experiments/student_mixed_initial_sac_lstm.yaml
/experiments/student_mixed_initial_sac_mlp.yaml
/experiments/student_ppo_lstm.yaml
/experiments/student_ppo_mlp.yaml
/experiments/student_sac_lstm.yaml
/experiments/student_sac_mlp.yaml

# Official simulator initialization files under scripts
/scripts/f15_cruise.xml
/scripts/f16_cruise
/scripts/f16_cruise.xml
/scripts/fa50_cruise.xml

# Official source is supplied by Release_260727. Track only our patched files.
/src/**
!/src/dogfight/
/src/dogfight/**
!/src/dogfight/ai/
/src/dogfight/ai/**
!/src/dogfight/ai/rllib_utils.py
!/src/dogfight/envs/
/src/dogfight/envs/**
!/src/dogfight/envs/single_agent_env.py

# Official dashboard/viewer is supplied unchanged by Release_260727.
/tools/

