# ============================================================
# AIP Team Training repository
# Track team code/configuration; exclude generated and licensed binaries.
# ============================================================

# Python cache and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*
!.env.example

# IDE and OS files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Temporary/editor files
*.tmp
*.temp
*.bak
*.swp
*~

# Ray/RLlib generated state
ray_results/
.ray/
/tmp/

# Training artifacts: ignore large/generated content by default
/artifacts/**

# Keep only compact team-comparison summaries
!/artifacts/altitude_native_curriculum_v1/
/artifacts/altitude_native_curriculum_v1/**
!/artifacts/altitude_native_curriculum_v1/pipeline_state.json
!/artifacts/altitude_native_curriculum_v1/screen_results.csv
!/artifacts/altitude_native_curriculum_v1/stage_results.csv

!/artifacts/altitude_attack_followup_v1/
/artifacts/altitude_attack_followup_v1/**
!/artifacts/altitude_attack_followup_v1/pipeline_state.json
!/artifacts/altitude_attack_followup_v1/attack_stage_results.csv

# Never commit models, native checkpoints, replay/log output or backups
/artifacts/models/
/artifacts/checkpoints/
/artifacts/logs/
/artifacts/dashboard/
/artifacts/records/
/artifacts/release_merge_backups/

# Native libraries and compiled binaries supplied with the official release
*.dll
*.so
*.dylib
*.exe
*.pdb

# Official simulator/data directories: each member should install Release_260727
/aircraft/
/engine/
/assets/
/RLLibLstm/

